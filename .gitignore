# ── Secrets — never commit a real .env. Only *.env.example templates are tracked. ──
.env
**/.env
.env.*
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
secrets/

# ── Python ──
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# ── Node / frontend ──
frontend/node_modules/
frontend/dist/
frontend/public/engine/
frontend/test-results/
frontend/playwright-report/
*.local
npm-debug.log*

# ── Runtime data ──
data/chess.sqlite3*
data/traces/
data/study/mine/
*.log

# ── OS / editor ──
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Playwright run output at the repo root
test-results/

# Capacitor native projects: generated by `npx cap add` (CI does it); never committed
frontend/android/
frontend/ios/
