# ─────────────────────────────────────────────────────────────────────────────
# Chess Coach — environment. Copy to `.env` (gitignored). Every value is optional:
# the app runs with none of them set.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──
HOST=127.0.0.1
PORT=8765
# Browser origins allowed to call the API in development (the Vite dev server).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Engine ──
# Blank = auto-detect: `stockfish` on PATH, /usr/games/stockfish, Homebrew, then the WASM
# build under frontend/node_modules run by `node`. Set it to a native binary for the fastest
# game review: https://stockfishchess.org/download/
STOCKFISH_PATH=
ENGINE_THREADS=1
ENGINE_HASH_MB=64

# ── Coach (a language model, optional) ──
# Without a model the coach answers from rules only. With one, explanations, hints, chat and
# review narratives are worded by the model. The model only words what the engine found: every
# move it may name comes from the position facts, and the app flags any other move. Only the
# position, the engine lines and your question leave your machine.
#
# Option A: any OpenAI-compatible server. Set COACH_BASE_URL and COACH_MODEL. COACH_API_KEY stays
# empty for a local server. Then run `python -m scripts.check_coach` to test the setup.
#   Local Ollama (free, private)       http://localhost:11434/v1   model: gpt-oss:20b   (about 14 GB)
#   Ollama Cloud (after `ollama signin`) http://localhost:11434/v1 model: gpt-oss:120b-cloud
#   Local LM Studio                    http://localhost:1234/v1    model: the name LM Studio shows
#   Local llama.cpp (llama-server)     http://localhost:8080/v1
#   Groq (free tier, needs a key)      https://api.groq.com/openai/v1   model: openai/gpt-oss-120b
#   OpenRouter (free ":free" models)   https://openrouter.ai/api/v1     model: any id ending in :free
COACH_BASE_URL=
COACH_MODEL=
COACH_API_KEY=
# A thinking model spends tokens on thought first; raise this to 4096 if answers come back empty.
COACH_MAX_TOKENS=2048
#
# Option B: Anthropic. Used only when COACH_BASE_URL and COACH_MODEL are empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5-1
COACH_EFFORT=medium

# ── Storage ──
# SQLite file for games, reviews, puzzle attempts and lesson progress.
DB_PATH=data/chess.sqlite3
